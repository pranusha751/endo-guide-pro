generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Case {
  id            String   @id @default(uuid())
  userId        String
  patientName   String?
  patientAge    String?
  patientGender String?
  tooth         String
  dx            String
  date          String
  status        String
  fileSystem    String?
  timestamp     Float
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
